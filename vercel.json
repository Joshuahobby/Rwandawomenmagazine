{
  "version": 2,
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api"
    },
    {
      "source": "/uploads/(.*)",
      "destination": "/uploads/$1"
    },
    {
      "source": "/wp-content/(.*)",
      "destination": "/wp-content/$1"
    },
    {
      "source": "/((?!api|uploads|wp-content).*)",
      "destination": "/index.html"
    }
  ]
}